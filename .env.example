# Supabase (Auth + API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for OAuth redirects (optional — auto-detected on Vercel via VERCEL_URL)
# NEXT_PUBLIC_SITE_URL=https://dev-vault-nu.vercel.app

# Google Analytics 4 measurement ID (optional; omit in dev to disable tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# hCaptcha site key (required when Supabase CAPTCHA protection is enabled)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=ce5c812e-....-....-....-....-....

# Drizzle RLS client pool — must use a role subject to RLS (e.g. rls_client)
DATABASE_URL=postgresql://rls_client:change-me@db.your-project-ref.supabase.co:5432/postgres

# Drizzle admin pool — migrations and trusted bypass (postgres user)
ADMIN_DATABASE_URL=postgresql://postgres.your-project-ref:change-me@db.your-project-ref.supabase.co:5432/postgres

# Upstash Redis (auth rate limiting) — auto-provisioned via Vercel Marketplace
# Run `vercel env pull .env.local` after linking the Upstash integration
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Set to "true" to disable new user registration
DISABLE_SIGNUP=false

